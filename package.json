{
  "name": "steam-to-calendar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next/dev",
    "dev:turbopack": "next dev",
    "build:steam-cli": "node scripts/build-steam-cli.mjs",
    "prebuild": "npm run build:steam-cli",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "ops:deploys": "node scripts/ops.mjs deploys",
    "ops:errors": "node scripts/ops.mjs errors",
    "ops:events": "node scripts/ops.mjs events",
    "ops:today": "node scripts/ops.mjs today",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "env -u NO_COLOR FORCE_COLOR=0 NODE_OPTIONS=--disable-warning=DEP0205 playwright test --grep-invert @steam-live",
    "test:e2e:live": "env -u NO_COLOR FORCE_COLOR=0 NODE_OPTIONS=--disable-warning=DEP0205 playwright test --grep @steam-live",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "flag-icons": "^7.5.0",
    "ics": "^3.12.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
