# Local development can point at an already-built steam-cli binary.
# Run `npm run build:steam-cli` first to build the bundled CLI.
STEAM_CLI_PATH=bin/steam-cli

# Optional. Defaults keep date strings compatible with the current calendar parser.
STEAM_CLI_CC=US
STEAM_CLI_LANG=english
STEAM_CLI_UI_LANG=en
STEAM_CLI_REQUEST_TIMEOUT_SECONDS=12
STEAM_CLI_PROCESS_TIMEOUT_MS=45000
STEAM_CLI_HISTORY_CACHE_TTL_MS=21600000

# Optional. Enables advanced Steam price history sale windows through steam-cli history.
# Without this key, calendar generation falls back to Steam's current discount data.
STEAM_CLI_ITAD_KEY=

# Optional. Enables Umami page views and client-side custom events.
# For Umami Cloud, create a website and paste its website ID here.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Optional build-time overrides.
STEAM_CLI_SOURCE_DIR=vendor/steam-cli
STEAM_CLI_GO_VERSION=1.22.12
STEAM_CLI_LDFLAGS=-s -w -buildid=
