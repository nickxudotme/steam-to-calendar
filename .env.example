# Local development can point at an already-built steam-cli binary.
# Run `npm run build:steam-cli` first to build the bundled CLI.
STEAM_CLI_PATH=bin/steam-cli

# Optional. Defaults keep date strings compatible with the current calendar parser.
STEAM_CLI_CC=US
STEAM_CLI_LANG=english
STEAM_CLI_UI_LANG=en
STEAM_CLI_REQUEST_TIMEOUT_SECONDS=12
STEAM_CLI_PROCESS_TIMEOUT_MS=45000
STEAM_CLI_HISTORY_CACHE_TTL_MS=21600000

# Optional. Enables advanced Steam price history sale windows through steam-cli history.
# Without this key, calendar generation falls back to Steam's current discount data.
STEAM_CLI_ITAD_KEY=

# Optional. Enables Umami page views and client-side custom events.
# For Umami Cloud, create a website and paste its website ID here.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=312a5b89-c994-4d81-a96b-63239f4fdbf0
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.nickxu.me/script.js

# Optional. Enables Umami session replays through the self-hosted recorder script.
# Inputs are masked by default, and the manual subscribe URL block is excluded from recordings.
NEXT_PUBLIC_UMAMI_REPLAY_ENABLED=1
NEXT_PUBLIC_UMAMI_RECORDER_URL=https://umami.nickxu.me/recorder.js
NEXT_PUBLIC_UMAMI_REPLAY_SAMPLE_RATE=1
NEXT_PUBLIC_UMAMI_REPLAY_MASK_LEVEL=moderate
NEXT_PUBLIC_UMAMI_REPLAY_MAX_DURATION=300000
NEXT_PUBLIC_UMAMI_REPLAY_BLOCK_SELECTOR=.manualSubscribeHint

# Optional. Keep localhost analytics disabled unless explicitly debugging Umami locally.
NEXT_PUBLIC_UMAMI_ALLOW_LOCALHOST=0

# Optional. Keep off by default; enable briefly when debugging user-visible flows.
# When enabled, client analytics includes raw game search input and raw Steam wishlist input.
NEXT_PUBLIC_ANALYTICS_CAPTURE_RAW_INPUTS=0

# Optional server-side Umami event collection. Falls back to NEXT_PUBLIC_UMAMI_WEBSITE_ID.
UMAMI_WEBSITE_ID=312a5b89-c994-4d81-a96b-63239f4fdbf0
UMAMI_COLLECT_URL=https://umami.nickxu.me/api/send
UMAMI_HOSTNAME=steamcalendar.com

# Optional local operations reporting. Do not expose these through NEXT_PUBLIC_*.
# Self-hosted Umami uses username/password login; Umami Cloud can use UMAMI_API_KEY.
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_API_CLIENT_ENDPOINT=https://umami.nickxu.me/api

# Optional build-time overrides.
STEAM_CLI_SOURCE_DIR=vendor/steam-cli
STEAM_CLI_GO_VERSION=1.22.12
STEAM_CLI_LDFLAGS=-s -w -buildid=
